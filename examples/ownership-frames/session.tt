let Systems = import "./systems.tt";
let run = fn frames => do {
  let world = @own {
    .frame = 0;
    .entities = [
      { .id = 1; .position = 10; .velocity = 3; },
      { .id = 2; .position = 20; .velocity = -2; }
    ];
  };
  let before = @snapshot world;
  let next = @evolve (@move world) by frames with Systems.advance;
  let checksum = @borrow next as view in
    fold (fn sum => fn entity => sum + entity.position) 0 view.entities;
  return { .before = @take (@move before); .after = @take (@move next); .checksum = checksum; };
};
return { .run = run; };
