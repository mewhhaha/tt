let Ops = import "./operations.tt";
let Scene = import "./scene.tt";
return handle Ops.Step with (fn ignored => 2) in
  handle Ops.Axis with (fn ignored => 1) in
  handle Ops.Report with (fn total => ()) in
    Scene.advance [
      { .id = 1; .position = 10; .velocity = 3; },
      { .id = 2; .position = 20; .velocity = -2; }
    ];
