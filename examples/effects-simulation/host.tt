let Ops = import "./operations.tt";
let Scene = import "./scene.tt";
return handle Ops.Step with host Ops.Step in
  handle Ops.Axis with host Ops.Axis in
  handle Ops.Report with host Ops.Report in
    Scene.advance [
      { .id = 1; .position = 10; .velocity = 3; },
      { .id = 2; .position = 20; .velocity = -2; }
    ];
